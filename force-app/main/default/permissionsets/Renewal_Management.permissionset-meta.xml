<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Renewal Management</label>
    <description>Grants account managers and renewal team members access to Service Agreements and the Upcoming Renewals experience. Required fields (Account, Start Date, End Date, Status) are always editable for users with object access and therefore are not listed.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <applicationVisibilities>
        <application>Renewals</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>UpcomingRenewalsController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Service_Agreement__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Service_Agreement__c.Agreement_Value__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Agreement__c.Renewal_Required__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Agreement__c.Account_Manager__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Service_Agreement__c.Renewal_Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Event.Renewal_End_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Task.Renewal_End_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Service_Agreement__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Upcoming_Renewals</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
