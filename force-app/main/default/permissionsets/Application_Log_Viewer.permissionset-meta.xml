<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Application Log Viewer</label>
    <description>Read-only access to all Application Log records, intended for administrators and support. Log records are written by automation in system mode, so regular users do not need this permission set.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Application_Log__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Application_Log__c.Source__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Application_Log__c.Severity__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Application_Log__c.Message__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Application_Log__c.Record_Id__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Application_Log__c.Stack_Trace__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Application_Log__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
